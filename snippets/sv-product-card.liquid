<article class="sv-card">
  <div class="sv-card-media">
    {% assign variant = product.selected_or_first_available_variant %}
    {% if variant.inventory_management and variant.inventory_quantity <= section.settings.low_stock_threshold and variant.inventory_quantity > 0 %}<span class="sv-card-stock is-low">{{ variant.inventory_quantity }} left</span>{% endif %}
    <button class="sv-card-wish" type="button" data-wishlist-app-hook data-product-id="{{ product.id }}" aria-label="Add {{ product.title | escape }} to wishlist">{% render 'sv-icons', icon: 'heart' %}</button>
    {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="600" height="600">{% endif %}
    <button class="sv-card-quickadd-btn" type="button">Quick Add</button>
    <div class="sv-quickadd-panel"><div class="sv-quickadd-panel-head"><span>Select size</span><button class="sv-quickadd-close" type="button" aria-label="Close size selector">{% render 'sv-icons', icon: 'close' %}</button></div><div class="sv-size-row">{% for option in product.options_with_values %}{% if option.name contains 'Size' %}{% for value in option.values %}{% for product_variant in product.variants %}{% if product_variant.options contains value and product_variant.available %}<button class="sv-size-chip" type="button" data-sv-add data-variant-id="{{ product_variant.id }}">{{ value }}</button>{% break %}{% endif %}{% endfor %}{% endfor %}{% endif %}{% endfor %}</div></div>
  </div>
  <div class="sv-card-body"><h3>{{ product.title }}</h3><p class="sv-card-tag">{{ product.vendor }}</p><p class="sv-card-price">{{ product.price | money }}</p></div>
</article>

<section class="sv-collection" id="shop"><div class="sv-collection-head"><div><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.subheading }}</p></div>{% if section.settings.collection %}<a class="sv-collection-viewall" href="{{ section.settings.collection.url }}">{{ section.settings.link_text }}</a>{% endif %}</div><div class="sv-product-grid">{% if section.settings.collection %}{% for product in section.settings.collection.products limit: section.settings.product_count %}{% render 'sv-product-card', product: product %}{% endfor %}{% else %}<p>Select a collection in the theme editor.</p>{% endif %}</div></section>
{% schema %}{"name":"SoleVault collection","settings":[{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"product_count","label":"Product count","min":2,"max":12,"step":1,"default":6},{"type":"range","id":"low_stock_threshold","label":"Low stock threshold","min":1,"max":20,"step":1,"default":6},{"type":"text","id":"heading","label":"Heading","default":"This week's picks"},{"type":"text","id":"subheading","label":"Subheading","default":"Six styles from the Vault Drop, restocking as sizes sell out."},{"type":"text","id":"link_text","label":"Collection link","default":"View All"}],"presets":[{"name":"SoleVault collection"}]}{% endschema %}

<section class="sv-collection" id="shop">
  <div class="sv-collection-head">
    <div>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
    {%- if section.settings.collection != blank -%}
      <a class="sv-collection-viewall" href="{{ section.settings.collection.url }}">{{ section.settings.link_text }}</a>
    {%- endif -%}
  </div>

  <div class="sv-product-grid" id="svProductGrid">
    {%- if section.settings.collection != blank -%}
      {%- for product in section.settings.collection.products limit: section.settings.product_count -%}
        {% render 'sv-product-card', product: product, low_stock_threshold: section.settings.low_stock_threshold %}
      {%- else -%}
        <p class="sv-collection-placeholder">[Placeholder] This collection has no products yet.</p>
      {%- endfor -%}
    {%- else -%}
      <p class="sv-collection-placeholder">[Placeholder] Select a collection in the theme editor to populate this grid.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "sv-collection-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This week's picks"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Six styles from the Vault Drop, restocking as sizes sell out."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "View all label",
      "default": "View All"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "Number of products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "Low stock badge threshold",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 6,
      "info": "Shows “X left” when the selected variant quantity is at or below this number."
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}

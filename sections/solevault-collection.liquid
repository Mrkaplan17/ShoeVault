<section class="sv-collection">
  {%- liquid
    assign selected_collection = section.settings.collection
    assign show_real_products = false
    if selected_collection != blank and selected_collection.products_count > 0
      assign show_real_products = true
    endif
    assign placeholder_count = section.settings.product_count | default: 6
    if placeholder_count > 8
      assign placeholder_count = 8
    endif
    if placeholder_count < 4
      assign placeholder_count = 4
    endif
  -%}
  <div class="sv-collection-head">
    <div>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
    {%- if show_real_products -%}
      <a class="sv-collection-viewall" href="{{ selected_collection.url }}">{{ section.settings.link_text }}</a>
    {%- endif -%}
  </div>

  <div class="sv-product-grid">
    {%- if show_real_products -%}
      {%- for product in selected_collection.products limit: section.settings.product_count -%}
        {% render 'sv-product-card', product: product, low_stock_threshold: section.settings.low_stock_threshold %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..placeholder_count) -%}
        {% render 'sv-product-card', placeholder: true, placeholder_index: forloop.index, placeholder_price: '₱850' %}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Vault collection",
  "tag": "section",
  "class": "sv-collection-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This week's picks"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Six styles from the Vault Drop, restocking as sizes sell out."
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "View all label",
      "default": "View All"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "Number of products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "Low stock badge threshold",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 6,
      "info": "Shows “X left” when the selected variant quantity is at or below this number."
    }
  ],
  "presets": [
    {
      "name": "Vault collection"
    }
  ]
}
{% endschema %}

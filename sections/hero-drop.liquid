<section class="sv-hero"><div class="sv-hero-content"><p class="sv-hero-eyebrow">{{ section.settings.eyebrow }}</p><h1>{{ section.settings.headline }}</h1><div class="sv-hero-sub">{{ section.settings.subheading }}</div><div class="sv-hero-ctas">{% if section.settings.primary_text != blank %}<a class="sv-btn sv-btn-primary" href="{{ section.settings.primary_url }}">{{ section.settings.primary_text }}</a>{% endif %}{% if section.settings.secondary_text != blank %}<a class="sv-btn sv-btn-secondary" href="{{ section.settings.secondary_url }}">{{ section.settings.secondary_text }}</a>{% endif %}</div><div class="sv-hero-meta">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><h4>{{ block.settings.number }}</h4><p>{{ block.settings.label }}</p></div>{% endfor %}</div></div><div class="sv-hero-visual">{% if section.settings.image %}<img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image.alt | escape }}" width="1200" height="900">{% endif %}{% if section.settings.product %}{% assign tag_product = section.settings.product %}<div class="sv-hero-tag"><span class="sv-hero-tag-dot"></span><div><p class="sv-tag-title">{{ tag_product.title }}</p><p class="sv-tag-sub">{{ tag_product.price | money }}{% if tag_product.available %}, available{% else %}, sold out{% endif %}</p></div></div>{% endif %}</div></section>
{% schema %}{"name":"SoleVault hero drop","blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"number","label":"Number","default":"40+"},{"type":"text","id":"label","label":"Label","default":"New styles this drop"}]}],"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"FW26 Collection"},{"type":"text","id":"headline","label":"Headline","default":"The Vault Drop is live."},{"type":"richtext","id":"subheading","label":"Subheading","default":"<p>Forty new silhouettes, built from the ground up for pavement, not podiums. Limited runs, gone by Sunday.</p>"},{"type":"text","id":"primary_text","label":"Primary CTA","default":"Shop the Drop"},{"type":"url","id":"primary_url","label":"Primary URL"},{"type":"text","id":"secondary_text","label":"Secondary CTA","default":"View Lookbook"},{"type":"url","id":"secondary_url","label":"Secondary URL"},{"type":"image_picker","id":"image","label":"Hero image"},{"type":"product","id":"product","label":"Availability tag product"}],"presets":[{"name":"SoleVault hero drop","blocks":[{"type":"stat"},{"type":"stat","settings":{"number":"24h","label":"Express delivery"}},{"type":"stat","settings":{"number":"100%","label":"Authenticity guaranteed"}}]}]}{% endschema %}

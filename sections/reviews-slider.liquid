<section class="sv-reviews"><div class="sv-reviews-head"><div><h2>{{ section.settings.heading }}</h2><div class="sv-reviews-summary"><span class="sv-stars">{% for i in (1..5) %}★{% endfor %}</span><p><strong>{{ section.settings.rating }}</strong> from {{ section.settings.buyer_count }} verified buyers</p></div></div></div><div class="sv-reviews-track">{% for block in section.blocks %}<article class="sv-review-card" {{ block.shopify_attributes }}><span class="sv-review-quote-mark">&rdquo;</span><div class="sv-stars">{% for i in (1..5) %}{% if i <= block.settings.rating %}★{% endif %}{% endfor %}</div><div class="sv-review-text">{{ block.settings.quote }}</div><div class="sv-review-author"><div class="sv-review-avatar">{{ block.settings.author_name | slice: 0 }} </div><div class="sv-review-author-info"><h4>{{ block.settings.author_name }}</h4><p>{{ block.settings.author_location }}</p></div></div></article>{% endfor %}</div></section>
{% schema %}{"name":"SoleVault reviews","blocks":[{"type":"review","name":"Review","settings":[{"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},{"type":"richtext","id":"quote","label":"Quote","default":"<p>The VaultFoam still feels like day one. My knees noticed the difference immediately.</p>"},{"type":"text","id":"author_name","label":"Author","default":"Jamie M."},{"type":"text","id":"author_location","label":"Location","default":"Verified buyer, Manila"}]}],"settings":[{"type":"text","id":"heading","label":"Heading","default":"What runners are saying"},{"type":"text","id":"rating","label":"Aggregate rating","default":"4.8"},{"type":"text","id":"buyer_count","label":"Buyer count","default":"2,300+"}],"presets":[{"name":"SoleVault reviews","blocks":[{"type":"review"},{"type":"review","settings":{"author_name":"Renz C.","author_location":"Verified buyer, Naga City"}},{"type":"review","settings":{"author_name":"Dana P.","author_location":"Verified buyer, Cebu City"}}]}]}{% endschema %}

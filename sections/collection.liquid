{% comment %}
  Collection page product grid with onboarding placeholders when empty.
{% endcomment %}

{%- liquid
  assign placeholder_count = 8
  assign show_real_products = false
  if collection != blank and collection.products_count > 0
    assign show_real_products = true
  endif
-%}

<section class="sv-collection">
  <div class="sv-collection-head">
    <div>
      <h2>{{ collection.title | default: 'Collection' }}</h2>
      {%- if collection.description != blank -%}
        <p>{{ collection.description | strip_html | truncatewords: 24 }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="sv-product-grid">
    {%- if show_real_products -%}
      {% paginate collection.products by 24 %}
        {%- for product in collection.products -%}
          {% render 'sv-product-card', product: product, low_stock_threshold: 6 %}
        {%- endfor -%}
        {%- if paginate.pages > 1 -%}
          <div class="sv-collection-pagination">
            {{ paginate | default_pagination }}
          </div>
        {%- endif -%}
      {% endpaginate %}
    {%- else -%}
      {%- for i in (1..placeholder_count) -%}
        {% render 'sv-product-card', placeholder: true, placeholder_index: forloop.index, placeholder_price: '₱850' %}
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .sv-collection-pagination {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    padding-top: 12px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection",
  "settings": []
}
{% endschema %}

<section class="sv-trust">{% for block in section.blocks %}<div class="sv-trust-item" {{ block.shopify_attributes }}>{% if block.settings.icon %}<div class="sv-trust-icon"><img src="{{ block.settings.icon | image_url: width: 88 }}" alt="" width="44" height="44"></div>{% endif %}<div class="sv-trust-text"><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></div></div>{% endfor %}</section>
{% schema %}{"name":"SoleVault trust badges","max_blocks":4,"blocks":[{"type":"badge","name":"Badge","settings":[{"type":"image_picker","id":"icon","label":"Icon"},{"type":"text","id":"heading","label":"Heading","default":"Express Shipping"},{"type":"text","id":"text","label":"Text","default":"Delivered within 24 hours on all express orders"}]}],"presets":[{"name":"SoleVault trust badges","blocks":[{"type":"badge"},{"type":"badge","settings":{"heading":"Authentic Guarantee","text":"Every pair verified and sealed before it ships"}},{"type":"badge","settings":{"heading":"Easy Returns","text":"30 days to send it back, no questions asked"}}]}]}{% endschema %}

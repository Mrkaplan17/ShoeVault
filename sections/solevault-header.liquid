<header class="sv-header"><a class="sv-logo" href="{{ routes.root_url }}">SOLE<span>VAULT</span></a><nav class="sv-nav" aria-label="Main navigation">{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title }}</a>{% endfor %}</nav><div class="sv-utils"><button class="sv-icon-btn sv-search-toggle" type="button" data-sv-search-open aria-label="Search">{% render 'sv-icons', icon: 'search' %}</button><a class="sv-icon-btn" href="{{ routes.account_url }}" aria-label="Account">{% render 'sv-icons', icon: 'account' %}</a><button class="sv-cart-btn" type="button" data-sv-cart-open aria-label="Open cart">{% render 'sv-icons', icon: 'cart' %}<span>Cart</span><span class="sv-badge{% if cart.item_count == 0 %} is-empty{% endif %}" data-sv-cart-count>{{ cart.item_count }}</span></button></div></header><div class="sv-search-overlay" data-sv-search><div class="sv-search-panel"><form class="sv-search-inner" action="{{ routes.search_url }}" method="get"><input name="q" type="search" placeholder="Search shoes, styles, drops..." aria-label="Search"><button class="sv-search-close" type="button" data-sv-search-close aria-label="Close search">{% render 'sv-icons', icon: 'close' %}</button></form></div></div>{% render 'sv-cart-drawer', threshold: section.settings.free_shipping_threshold %}<script defer src="{{ 'cart.js' | asset_url }}"></script>
{% schema %}{"name":"SoleVault header","settings":[{"type":"link_list","id":"menu","label":"Main menu","default":"main-menu"},{"type":"number","id":"free_shipping_threshold","label":"Free shipping threshold","default":1200}]}{% endschema %}

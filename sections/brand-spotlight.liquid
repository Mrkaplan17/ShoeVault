<section class="sv-spotlight"><div class="sv-spotlight-visual">{% if section.settings.image %}<img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | escape }}" width="900" height="700" loading="lazy">{% endif %}</div><div class="sv-spotlight-content"><h2>{{ section.settings.heading }}</h2><div class="sv-spotlight-copy">{{ section.settings.body }}</div><div class="sv-spec-list">{% for block in section.blocks %}<div class="sv-spec-row" {{ block.shopify_attributes }}><span class="sv-spec-label">{{ block.settings.label }}</span><span class="sv-spec-value{% if block.settings.highlight %} is-signal{% endif %}">{{ block.settings.value }}</span></div>{% endfor %}</div>{% if section.settings.cta_text != blank %}<a class="sv-spotlight-cta" href="{{ section.settings.cta_url }}">{{ section.settings.cta_text }}</a>{% endif %}</div></section>
{% schema %}{"name":"SoleVault brand spotlight","blocks":[{"type":"spec","name":"Spec","settings":[{"type":"text","id":"label","label":"Label","default":"Energy return"},{"type":"text","id":"value","label":"Value","default":"73%"},{"type":"checkbox","id":"highlight","label":"Highlight","default":false}]}],"settings":[{"type":"text","id":"heading","label":"Heading","default":"Meet VaultFoam."},{"type":"richtext","id":"body","label":"Body","default":"<p>A dual-density compound engineered to compress under heel strike and rebound through toe-off, built into every SoleVault midsole since 2022.</p>"},{"type":"image_picker","id":"image","label":"Spotlight image"},{"type":"text","id":"cta_text","label":"CTA text","default":"Explore the technology"},{"type":"url","id":"cta_url","label":"CTA URL"}],"presets":[{"name":"SoleVault brand spotlight","blocks":[{"type":"spec"},{"type":"spec","settings":{"label":"Weight per midsole","value":"98g"}},{"type":"spec","settings":{"label":"Compression set, 500 mi","value":"Under 4%"}}]}]}{% endschema %}

[
  {
    "name": "theme_info",
    "theme_name": "SoleVault",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "archivo_n4",
        "label": "Primary"
      }
    ]
  },
  {
    "name": "SoleVault colors",
    "settings": [
      { "type": "color", "id": "sv_ink", "label": "Ink", "default": "#0E0E10" },
      { "type": "color", "id": "sv_fog", "label": "Fog", "default": "#F5F4F2" },
      { "type": "color", "id": "sv_hairline", "label": "Hairline", "default": "#E4E2DD" },
      { "type": "color", "id": "sv_slate", "label": "Slate", "default": "#8A8782" },
      { "type": "color", "id": "sv_signal", "label": "Signal", "default": "#FF4D2E" }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Page width",
        "options": [
          {
            "value": "90rem",
            "label": "Narrow"
          },
          {
            "value": "110rem",
            "label": "Wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Page margin",
        "default": 20
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "Background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "Foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "Input corner radius",
        "default": 4
      }
    ]
  },
  {
    "name": "Color palette",
    "settings": [
      {
        "type": "color_palette",
        "id": "color_palette",
        "default": {
          "background": "#FFFFFF",
          "foreground": "#0E0E10"
        }
      }
    ]
  },
  {
    "name": "Logo and favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "image_picker",
        "id": "logo_inverse",
        "label": "Inverse logo"
      }
    ]
  }
]

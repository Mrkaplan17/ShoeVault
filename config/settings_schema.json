      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "archivo_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "SoleVault colors",
    "settings": [
      { "type": "color", "id": "sv_ink", "label": "Ink", "default": "#0E0E10" },
      { "type": "color", "id": "sv_fog", "label": "Fog", "default": "#F5F4F2" },
      { "type": "color", "id": "sv_hairline", "label": "Hairline", "default": "#E4E2DD" },
      { "type": "color", "id": "sv_slate", "label": "Slate", "default": "#8A8782" },
      { "type": "color", "id": "sv_signal", "label": "Signal", "default": "#FF4D2E" }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  }
